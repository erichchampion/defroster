# Firebase Client Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# CARTO Basemaps API key (REQUIRED for the map basemap)
# Required since Sept 2026 — free for non-commercial use, no account needed
# Request at https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=your_carto_basemaps_key_here

# Base URL for origin validation (BFF pattern)
# Must match your production domain exactly (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Admin SDK (Server-side only)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Cron Job Authentication (Server-side only)
# Generate a secure random key: openssl rand -hex 32
CRON_SECRET=your_secure_64_character_cron_secret_here

# Upstash Redis for distributed rate limiting (Optional for development, required for production)
# Get from Upstash Console: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
